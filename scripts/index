#!/usr/bin/env python3
"""Writes index.yaml, the stacks of the registry as damstack lists them.

index            writes it
index --check    fails when index.yaml is not what the stacks say
"""

import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
URL = "https://github.com/damstack-dev/damstack-registry"
HEAD = (
    "# The stacks of the registry, as damstack lists them. scripts/index writes it\n"
    "# from their damstack.yaml; CI fails when it is not up to date.\n"
)


def manifests(kind: str) -> list[tuple[str, dict]]:
    out = []
    for path in sorted((ROOT / kind).glob("*/damstack.yaml")):
        out.append((f"{kind}/{path.parent.name}", yaml.safe_load(path.read_text())))
    return out


def capability(s: str) -> str:
    return s if "@" in s else s + "@1"


def capabilities(m: dict) -> dict:
    out = {}
    for key, value in (
        ("provides", m.get("provides")),
        ("requires", (m.get("requires") or {}).get("capabilities")),
        ("uses", m.get("uses")),
    ):
        if value:
            out[key] = value
    if m.get("recommended"):
        out["recommended"] = True
    return out


def index() -> str:
    platforms = manifests("platforms")
    apps = manifests("apps")
    stacks = []
    for path, m in platforms:
        entry = {"name": m["name"], "url": URL, "path": path, "description": m.get("description", "")}
        entry.update(capabilities(m))
        stacks.append(entry)
    for path, m in apps:
        needs = {capability(c) for c in m.get("requires", {}).get("provides", [])}
        hosts = [p["name"] for _, p in platforms if needs <= {capability(c) for c in p.get("provides", [])}]
        entry = {"name": m["name"], "kind": "app"}
        if len(hosts) == 1:
            entry["platform"] = hosts[0]
        entry.update({"url": URL, "path": path, "description": m.get("description", "")})
        entry.update(capabilities(m))
        stacks.append(entry)
    for path, m in platforms + apps:
        if m["name"] != Path(path).name:
            sys.exit(f"{path}: the directory is not named as the stack, {m['name']}")
    return HEAD + yaml.safe_dump({"stacks": stacks}, sort_keys=False, allow_unicode=True, width=1000)


def main() -> int:
    want = index()
    target = ROOT / "index.yaml"
    if sys.argv[1:] == ["--check"]:
        if not target.exists() or target.read_text() != want:
            print("index.yaml is not what the stacks say: run scripts/index and commit it", file=sys.stderr)
            return 1
        return 0
    target.write_text(want)
    return 0


if __name__ == "__main__":
    sys.exit(main())
