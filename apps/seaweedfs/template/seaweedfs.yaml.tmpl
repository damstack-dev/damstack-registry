# A shared SeaweedFS object lake. The policies refuse a plan that would destroy the
# lake; list the address under allow_destroy to let it go.
#
# bucket is the one bucket all identities are granted on. identities are the S3
# users: each gets an access key equal to its name and a generated secret key in
# Vault, with the given actions on the bucket. The default is one writer. For an
# app, set its own identities (for Sauron: a fetcher with Admin/Read/Write/List/
# Tagging and readers ingest, incidents, transcriber, ui, tools with Read/List).
bucket: lake
identities:
  - name: app
    actions: [Admin, Read, Write, List, Tagging]
# The Consul service mesh: enabled puts the S3 gateway behind an Envoy sidecar; mesh apps
# reach it as seaweedfs.virtual.consul, and only the services in allow may (intentions).
# Keep 8333 in keep_open_ports while some of its clients are not in the mesh yet.
#   mesh:
#     enabled: true
#     allow: [app]
#     keep_open_ports: [8333]
# A lake is reachable only inside the platform; it opens no public port.
public_ports: []
allow_destroy: []
