# A shared Mimir metric store. The policies refuse a plan that would destroy 
# metrics; list the address under allow_destroy to let it go.
# How long metric blocks are kept; 0s forever.
retention_period: 0s
# The Consul service mesh: enabled puts Mimir behind an Envoy sidecar; mesh apps (Grafana)
# reach it as mimir.virtual.consul, as allow lets them (intentions). Its HTTP port stays
# open for the platform's Alloy and Consul's UI, on the host.
#   mesh:
#     enabled: true
#     allow: [grafana]
# A metric store is reachable only inside the platform; it opens no public port.
public_ports: []
allow_destroy: []
