# A shared PostgreSQL for apps that set postgres.mode external. It knows nothing
# about the databases on it — each consumer app creates its own role and database.
# The policies refuse a plan that would destroy the data; list the address under
# allow_destroy to let it go.
image: postgres:16.10
admin_user: postgres
port: 5432
# The Consul service mesh: enabled puts it behind an Envoy sidecar; mesh apps reach it
# as postgres.virtual.consul, and only the services in allow may (intentions). Keep
# 5432 in keep_open_ports while some of its clients are not in the mesh yet.
#   mesh:
#     enabled: true
#     allow: [odoo]
#     keep_open_ports: [5432]
# A shared database is reachable only inside the platform; it opens no public port.
public_ports: []
allow_destroy: []
