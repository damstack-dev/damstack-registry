# The one file to edit. Ansible, OpenTofu and the policies of the hashi stack read it.
# Secrets are not here: they are in vault.yml, encrypted.

# Name of the stack, also the Consul and Nomad datacenter.
name: {{ .project }}

server:
  # Public address of the server, as the provider gave it.
  address: {{ yaml .server_address }}
  # The user you log in with today; the bootstrap step replaces it with ops_user.
  bootstrap_user: {{ yaml .bootstrap_user }}
  # The one user that may log in afterwards, with your SSH key. Chosen once: a set up server
  # refuses another name.
  ops_user: {{ yaml .ops_user }}
  # A user of that name that damstack did not create is left alone, unless this says to take
  # it over: then your key is added to it, and its other keys stay.
  adopt_user: false
  # Name of the server in Consul, Nomad and Vault. Chosen once: renaming a running node
  # breaks the Vault raft and leaves Nomad's jobs on the old node.
  node_name: server
  # Network interface of the server to the internet; auto takes the one of its default route.
  public_interface: auto
  # Ports open to the internet besides SSH and WireGuard. An app opens its own, under
  # apps.<app>.public_ports, such as 80 and 443 for traefik, the public entry.
  public_ports: []

# Private network over WireGuard. The server takes the first address of this /24,
# each client the next ones, in order.
network:
  # Chosen once, free among your projects: a set up server keeps it.
  cidr: {{ .network_cidr }}
  clients: {{ yaml .wireguard_clients }}

# The admin pages are https://consul.service.consul, https://nomad.service.consul and
# https://vault.service.consul, through WireGuard only, behind the internal Traefik with a
# certificate of the project's CA. Its own dashboard is at traefik.service.consul when on; it
# has no login of its own, so anyone on the private network sees the routes.
traefik:
  dashboard: false

# Vault seals itself every time it starts. true keeps its unseal keys on the server, readable
# by root only, so it unseals itself after a reboot; false leaves it sealed, and the platform
# down, until the next damstack deploy, with the keys only in vault.yml.
vault:
  auto_unseal: true
{{- if eq .private_registry "yes" }}

# A container registry the Nomad client logs in to, so jobs can pull private images.
# The password is the secret vault_registry_password. Remove this block for none.
registry:
  server: {{ yaml .registry_server }}
  username: {{ yaml .registry_username }}
{{- end }}

# Backups, made with restic: on the server every night, and on your laptop when damstack
# pulls them, every pull_every while the laptop is on (off: only damstack backup pull).
# restic compresses, deduplicates and encrypts them with vault_backup_password; damstack
# backup status shows what is on the laptop.
backup:
  schedule: "03:00"
  compression: auto
  server:
    path: /var/backups/restic
    keep: {daily: 7, weekly: 4, monthly: 6}
  laptop:
    path: ~/Backups/{{ .project }}
    keep: {daily: 30, weekly: 12, monthly: 24}
    pull_every: 1h

# Apps on the platform, each added with damstack app add <app>, under its name. A domain
# (damstack app add cloudflare, or manual) publishes the DNS records they need.
apps: {}
